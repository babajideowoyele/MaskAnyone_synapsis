# MaskAnyone Environment Configuration
# Copy this file to app.env and fill in real values before running.
#
#   cp app.env.example app.env
#
# IMPORTANT: Never commit app.env to version control.

# Platform mode: "server" (Keycloak auth) or "local" (no auth, single user)
# MASK_ANYONE_PLATFORM_MODE=local
MASK_ANYONE_PLATFORM_MODE=server

# --- Postgres ---
POSTGRES_DB=postgres
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

BACKEND_PG_HOST=postgres
BACKEND_PG_PORT=5432
BACKEND_PG_USER=CHANGE_ME
BACKEND_PG_PASSWORD=CHANGE_ME
BACKEND_PG_DATABASE=prototype

# --- Authentication ---
# RSA public key from Keycloak realm for JWT validation
BACKEND_AUTH_PUBLIC_KEY="CHANGE_ME"

# --- Worker ---
WORKER_BACKEND_BASE_PATH=http://python:8000/_worker/
WORKER_LOCAL_DATA_DIR=/worker_data
WORKER_API_KEY=CHANGE_ME

# --- Keycloak ---
KEYCLOAK_ADMIN=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KC_DB_USERNAME=CHANGE_ME
KC_DB_PASSWORD=CHANGE_ME

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=CHANGE_ME
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# --- Model configuration ---
OPENPOSE_MODEL_DIR=/workspace/openpose/models
SAM2_OFFLOAD_STATE_TO_CPU=false
SAM2_OFFLOAD_VIDEO_TO_CPU=false
