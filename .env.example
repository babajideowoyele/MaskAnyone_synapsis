# MaskAnyone Environment Configuration Example
# Copy this file to app.env and update the values

# Platform Mode: "local" for single-user without auth, "server" for multi-user with Keycloak
MASK_ANYONE_PLATFORM_MODE=server

# ============================================
# SECURITY - CHANGE THESE IN PRODUCTION!
# ============================================

# Worker API Key - Shared secret for worker-to-backend authentication
# Generate a new key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_API_KEY=CHANGE_ME_GENERATE_A_SECURE_KEY

# PostgreSQL Credentials - USE STRONG PASSWORDS IN PRODUCTION
POSTGRES_DB=postgres
POSTGRES_USER=maskanyone
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

BACKEND_PG_HOST=postgres
BACKEND_PG_PORT=5432
BACKEND_PG_USER=maskanyone
BACKEND_PG_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
BACKEND_PG_DATABASE=prototype

# JWT Public Key from Keycloak (RS256)
# Get this from Keycloak: Realm Settings -> Keys -> RS256 -> Public Key
BACKEND_AUTH_PUBLIC_KEY="YOUR_KEYCLOAK_PUBLIC_KEY_HERE"

# ============================================
# Service Configuration
# ============================================

WORKER_BACKEND_BASE_PATH=http://python:8000/_worker/
WORKER_LOCAL_DATA_DIR=/worker_data

OPENPOSE_MODEL_DIR=/workspace/openpose/models

SAM2_OFFLOAD_STATE_TO_CPU=false
SAM2_OFFLOAD_VIDEO_TO_CPU=false
